# Copy this to .env for local dev (never commit .env!)
# Set these as environment variables / secrets on your hosting platform

# MongoDB Atlas connection string (free M0 cluster)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/healthDB?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/healthDB?retryWrites=true&w=majority

# Port (usually set automatically by hosting platform — leave as 3000 locally)
PORT=3000
