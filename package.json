{
  "name": "karthik-health-dashboard",
  "version": "1.0.0",
  "description": "Dynamic Health Tracking Application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "NODE_ENV=test jest --runInBand --forceExit",
    "seed:admin": "node scripts/seed-admin.js",
    "migrate:logs": "node scripts/migrate-logs.js",
    "test:e2e": "playwright test tests/e2e/phase4-api-tests.spec.js",
    "test:e2e:phase4": "playwright test tests/e2e/phase4-api-tests.spec.js --headed",
    "test:e2e:update-snapshots": "playwright test tests/e2e/phase4-api-tests.spec.js --update-snapshots"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/setup.js",
    "globalTeardown": "./tests/teardown.js",
    "testTimeout": 30000,
    "testPathIgnorePatterns": [
      "<rootDir>/tests/e2e/"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.2.2"
  }
}
